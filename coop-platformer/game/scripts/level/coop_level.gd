const HELP_TEXT := "ЭТАП 3 — кооператив.  F2 — тестовая комната.  Падение в пропасть или за нижний край экрана — гибель"


func _init() -> void:
	other_scene = "res://scenes/test_room.tscn"


func get_map() -> Array:
	return MAP


func _ready() -> void:
	super._ready()
	var help := Label.new()
	help.text = HELP_TEXT
	help.position = Vector2(80, 1030)
	help.add_theme_font_size_override("font_size", 18)
	help.add_theme_color_override("font_color", Color(1, 1, 1, 0.7))
	hud.add_child(help)
