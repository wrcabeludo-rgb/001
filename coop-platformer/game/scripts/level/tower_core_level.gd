func _init() -> void:
	zone_id = "3-3"
	level_title = "Мир 3-3 · Ядро «Сердца»"
	music_track = "zone_3_3"
	wall_color = Color(0.32, 0.3, 0.36)
	backgrounds = Factory.backgrounds(BG_FAR, BG_MID, 6, 0.55)
	wall_texture = Factory.tile("3-3_wall")
	ground_texture = Factory.tile("3-3_ground")
	prop_skin = "tower"
	platform_texture = Factory.PLATFORM_TOWER


func _ready() -> void:
	super._ready()
	var arenas: Array = get_children().filter(func(node: Node) -> bool: return node is Arena)
	if arenas.size() >= 2:
		arenas[1].cleared.connect(_on_commander_beaten)


## The commander falls: the comic of who he was, then the way to the Heart.
func _on_commander_beaten() -> void:
	Sound.music(music_track)
	play_comic([
		{"image": _art("world3_commander_01"), "caption": "Шлем треснул. Мечник узнал это лицо.", "zoom": "in"},
		{"image": _art("world3_commander_02"),
			"caption": "— Двадцать лет я сторожил то, что нас сожгло. Иди. Решай сам.", "zoom": "out"},
	])


static func _art(name: String) -> Texture2D:
	var path := COMIC % name
	return load(path) if ResourceLoader.exists(path) else null


func get_map() -> Array:
	return MAP


func get_arena_waves(index: int) -> Array:
	return ARENA_WAVES[index] if index < ARENA_WAVES.size() else []


func get_signs() -> Array:
	return SIGNS
